{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Groundwork Security & Compliance design tokens. Identity = Soil. Action = Clay. Canvas = Paper.",
  "color": {
    "soil": { "$type": "color", "$value": "#1c2e26", "$description": "Primary identity. Logo field, dark sections." },
    "canopy": { "$type": "color", "$value": "#24382f", "$description": "Elevated surface on Soil." },
    "moss": { "$type": "color", "$value": "#4f6d58", "$description": "Kickers and success. Not a button fill." },
    "terrace": { "$type": "color", "$value": "#5c7a62", "$description": "Middle course in the mark. Logo-only in UI." },
    "sage": { "$type": "color", "$value": "#a8b5a0", "$description": "Secondary text on Soil." },
    "clay": { "$type": "color", "$value": "#c4785a", "$description": "Primary action and accent. One per composition." },
    "clay-deep": { "$type": "color", "$value": "#9e5438", "$description": "Action hover and emphasis." },
    "sand": { "$type": "color", "$value": "#f4efe6", "$description": "Warm alternate surface and type on Soil." },
    "paper": { "$type": "color", "$value": "#fbf8f2", "$description": "Default page canvas. Not pure white." },
    "ink": { "$type": "color", "$value": "#171c19", "$description": "Body and headlines on light surfaces." },
    "muted": { "$type": "color", "$value": "#5a635d", "$description": "Secondary copy on Paper." },
    "on-soil": { "$type": "color", "$value": "#f4efe6" },
    "on-clay": { "$type": "color", "$value": "#ffffff" },
    "link-on-dark": { "$type": "color", "$value": "#f0c2b0" },
    "line": { "$type": "color", "$value": "rgba(28, 46, 38, 0.12)" },
    "white": { "$type": "color", "$value": "#ffffff" }
  },
  "font": {
    "serif": {
      "$type": "fontFamily",
      "$value": ["Fraunces", "Iowan Old Style", "Georgia", "serif"],
      "$description": "Headlines only. Optical size 9–144, weight 480–560."
    },
    "sans": {
      "$type": "fontFamily",
      "$value": ["Outfit", "Avenir Next", "system-ui", "sans-serif"],
      "$description": "Body, UI, kickers, buttons."
    }
  },
  "fontWeight": {
    "body": { "$type": "fontWeight", "$value": 400 },
    "heading": { "$type": "fontWeight", "$value": 520 },
    "action": { "$type": "fontWeight", "$value": 600 }
  },
  "fontSize": {
    "kicker": { "$type": "dimension", "$value": "0.78rem" },
    "body": { "$type": "dimension", "$value": "17px" },
    "lede": { "$type": "dimension", "$value": "1.12rem" },
    "h3": { "$type": "dimension", "$value": "1.35rem" },
    "h2": { "$type": "dimension", "$value": "3.3rem" },
    "h1": { "$type": "dimension", "$value": "5.2rem" }
  },
  "letterSpacing": {
    "tight": { "$type": "dimension", "$value": "-0.035em" },
    "body": { "$type": "dimension", "$value": "-0.011em" },
    "kicker": { "$type": "dimension", "$value": "0.14em" }
  },
  "lineHeight": {
    "display": { "$type": "number", "$value": 1.08 },
    "body": { "$type": "number", "$value": 1.65 }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "12px" },
    "md": { "$type": "dimension", "$value": "18px" },
    "lg": { "$type": "dimension", "$value": "28px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "8px" },
    "sm": { "$type": "dimension", "$value": "12px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "40px" },
    "section": { "$type": "dimension", "$value": "84px" }
  },
  "size": {
    "nav": { "$type": "dimension", "$value": "74px" },
    "wrap": { "$type": "dimension", "$value": "1180px" },
    "mark": { "$type": "dimension", "$value": "34px" }
  },
  "shadow": {
    "raised": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "60px",
        "spread": "0px",
        "color": "rgba(28, 46, 38, 0.12)"
      }
    }
  },
  "breakpoint": {
    "collapse": { "$type": "dimension", "$value": "900px" }
  }
}
